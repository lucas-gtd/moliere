# === Configuration Molière ===
# Obtenez votre clé sur https://api.minimax.io

# Clé API MiniMax (obligatoire)
MOLIERE_API_KEY=

# Modèle par défaut (optionnel, défaut : MiniMax-M3)
MOLIERE_DEFAULT_MODEL=MiniMax-M3

# Endpoint API (optionnel, défaut : https://api.minimax.io/v1)
# MOLIERE_BASE_URL=https://api.minimax.io/v1

# Thème visuel (optionnel, valeurs : default, soir, parchemin)
# Le thème peut aussi être changé via /theme dans la session
# MOLIERE_THEME=default

# Mode de permissions (optionnel, valeurs : default, accept-edits, plan, yolo)
# Le mode peut aussi être changé via /permissions dans la session
# MOLIERE_PERMISSIONS=default
